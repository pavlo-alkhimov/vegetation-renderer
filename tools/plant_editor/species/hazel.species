# hazel - plant editor species (graph + parameters; seeds are separate)
lod = Lod @0,0
seed_structure = Seed @0,1 channel=structure
seed_foliage = Seed @0,2 channel=foliage
seed_texture = Seed @0,3 channel=texture
const1 = Const @0,4 value=2
const2 = Const @0,5 value=9
const3 = Const @0,6 value=1
trunk_segments = Expr @1,4 in=const1,lod,- expr="max(2, round(x*(1-0.17*y)))"
trunk_sides = Expr @1,5 in=const2,lod,- expr="max(3, round(x*pow(0.65,y)))"
trunk = Trunk @2,0 height=0.6 radius=0.07 taper=0.5 flare=0 lean=0 wobble=0 segments=@trunk_segments sides=@trunk_sides seed=@seed_structure
branches1 = Branches @3,0 in=trunk count=9~2 start=0.05 end=0.95 phyllotaxis=spiral angle=16~4 angle_jitter=8 az_jitter=40 length=8~1 length_top=0.8 radius=0.85 curvature=-0.06~0.04 droop=0.1 wobble=0.05 segments=8 max_lod=3 seed=@seed_structure
branches2 = Branches @4,0 in=branches1 count=12~2 start=0.25 end=0.97 phyllotaxis=spiral angle=45~5 angle_jitter=15 az_jitter=40 length=0.32~0.04 length_top=0.5 radius=0.4 curvature=0.1 droop=0.3~0.1 wobble=0.08 segments=4 max_lod=2 seed=@seed_structure
branches3 = Branches @5,0 in=branches2 count=6~1 start=0.1 end=0.95 phyllotaxis=distichous angle=45 angle_jitter=15 az_jitter=40 length=0.4 length_top=0.6 radius=0.5 curvature=0 droop=0.15 wobble=0.08 segments=2 max_lod=1 seed=@seed_structure
tropism = Tropism @6,0 in=branches3 gravity=0.06 photo=0.04 order_scale=0.5 seed=@seed_structure
prune = Prune @7,0 in=tropism shape=cylinder crown_base=0 width=0.42~0.05 mode=shrink min_order=2 min_keep=0.2 seed=@seed_structure
wood = Wood @8,0 in=prune sides=7|5|3|3 min_radius=0.002|0.003|0.005|0.007 tile=0.3 seed=@seed_structure
merge = Merge @9,0 in=wood,leafmesh,-
wireframe = Wireframe @10,0 in=merge enabled=off parts=all color=#ffd040
output = Output @11,0 in=wireframe,barktexture,leaftexture
leafshape = LeafShape @6,1 outline=ovate length=0.1~0.01 width=0.09~0.008 petiole=0.012 teeth=16 tooth_depth=0.1 fold=0.1 curl=0.1 detail=5|4|3|2 veins=6 seed=@seed_foliage
leaves = Leaves @7,1 in=prune,leafshape orders=2 density=8|4|2|1~1 start=0.2 arrangement=distichous angle=60~5 droop=0.1 roll=25 scale=1.5|2.121|3|4.243~0.1 size_jitter=0.2 seed=@seed_foliage
leafmesh = LeafMesh @8,1 in=leaves,leafshape color_var=0.1 hue_var=0.05 seed=@seed_foliage
leaftexture = LeafTexture @8,2 in=leafshape size=256 color=#3f6a20 vein_color=#86a650 vein_width=0.03 vein_angle=45 vein_contrast=0.45 network=16 color_var=0.12 roughness=0.6 normal_strength=0.7 seed=@seed_texture
barktexture = BarkTexture @9,2 size=512 furrows=2 stretch=3 furrow_width=0.03 furrow_depth=0.02 plates=4 plate_depth=0.02 lenticels=25 lenticel_contrast=0.5 octaves=5 moss=0.1 roughness=0.55 normal_strength=0.6 color_dark=#5a4a3e color_light=#9b8a78 moss_color=#5b6b2c lenticel_color=#c9b9a0 seed=@seed_texture
