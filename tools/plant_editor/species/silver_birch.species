# silver_birch - plant editor species (graph + parameters; seeds are separate)
trunk = Trunk @0,0 height=20~2 radius=0.2~0.03 taper=1~0.1 flare=0.3 lean=4~2 wobble=0.03~0.01 segments=12
branches1 = Branches @1,0 in=trunk count=24~3 start=0.3~0.04 end=0.97 phyllotaxis=spiral angle=42~5 angle_jitter=10 az_jitter=30 length=0.36~0.04 length_top=0.4 radius=0.45 curvature=0.5~0.1 droop=0.12~0.05 wobble=0.06 segments=6 max_lod=3
