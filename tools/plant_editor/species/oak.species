output = Output @9,0 in=wireframe,barktexture,leaftexture
leafshape = LeafShape @4,1 outline=lobed length=0.1~0.01 width=0.055~0.005 petiole=0.005 teeth=5 tooth_depth=0.5~0.05 fold=0.1 curl=0.1 detail=6 veins=6 lod_detail=1
